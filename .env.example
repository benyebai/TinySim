# OpenAI direct API mode:
# OPENAI_API_KEY=put_your_api_key_here
# OPENAI_MODEL=gpt-4.1-mini

# Vercel AI Gateway mode:
AI_GATEWAY_API_KEY=put_your_vercel_ai_gateway_key_here
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Keep this false for faster/cheaper live runs.
# If true, importance scoring also calls the model.
LIVE_LLM_IMPORTANCE=false
